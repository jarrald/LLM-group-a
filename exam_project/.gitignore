# StudyGraph — project-level ignores.
# Nested file: complements the repo-root .gitignore, which already covers
# __pycache__/, *.py[cod], .venv/, .pytest_cache/, .mypy_cache/, .ruff_cache/
# and .streamlit/secrets.toml.

# --- Local vector store (regenerated by scripts/ingest.py, binary) ---
data/chroma/

# --- Local application data (SQLite state, not source) ---
data/*.db
data/*.db-wal
data/*.db-shm
data/*.sqlite3

# --- Lecture source slides: binary, large, not redistributable.
# The converted Markdown under docs/RAG/**/week*/ IS committed, because the assignment
# requires reproducible RAG source material. ---
data/course_material/**/*.pdf
data/course_material/**/*.pptx
data/course_material/**/*.docx
docs/RAG/**/*.pdf
docs/RAG/**/*.png
docs/RAG/**/*.pyc

# --- Uploaded/experimental documents ---
data/uploads/

# --- Model and embedding caches ---
.cache/
models/

# --- Experiment artifacts that are regenerated on every run ---
experiments/**/artifacts/
regression/images/
regression/out/
regression/.chroma/

# --- Third-party corpus: the downloaded scikit-learn checkout (~23 MB, not ours) ---
regression/scikit-learn-main/
# Staging directory of regression/fetch_corpus.py; only exists during a download.
regression/.scikit-learn-main.download/

# --- Tutorial notebooks downloaded with the corpus ---
regression/scikit-learn-main/**/*.ipynb

# --- A venv created by mistake, e.g. `uv venv 3.10` (that name is a *path*, not a version) ---
3.10/

# --- Temporary scratch scripts created for one-off checks ---
_tmp_*.py
