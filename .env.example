# Copy to .env or export in your shell. All values override config.yaml.
# Role-level overrides: <ROLE>_ENDPOINT (full URL) and <ROLE>_MODEL.

# Architect (FR1) -- endpoint A
ARCHITECT_ENDPOINT=http://127.0.0.1:11434
ARCHITECT_MODEL=qwen2.5-coder:7b

# Tech lead (FR2) -- endpoint B
TECH_LEAD_ENDPOINT=http://127.0.0.1:11435
TECH_LEAD_MODEL=llama3.2:3b

# Worker pool (FR3)
WORKER_ENDPOINT=http://127.0.0.1:11434
WORKER_MODEL=qwen2.5-coder:7b

# Endpoint URL overrides (used when a server moves to another host/port)
OLLAMA_A_URL=http://127.0.0.1:11434
OLLAMA_B_URL=http://127.0.0.1:11435

# Workflow settings
WORKER_COUNT=2
